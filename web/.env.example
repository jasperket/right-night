# Copy to web/.env.local for `pnpm dev`. Dev-only values.
DATABASE_URL=postgres://rightnight:rightnight-dev@localhost:5433/rightnight
# Same value as N8N_SIGNING_SECRET in infra/.env. At least 32 chars.
N8N_SIGNING_SECRET=change-me-to-a-shared-secret-of-32-chars-or-more
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Where n8n (in Docker) reaches the app for callbacks.
APP_BASE_URL=http://host.docker.internal:3000
