# Copy to infra/.env for local development. Dev-only values; production secrets live in AWS SSM.
POSTGRES_USER=rightnight
POSTGRES_PASSWORD=rightnight-dev
POSTGRES_DB=rightnight
TEST_DB=rightnight_test
N8N_DB=n8n
POSTGRES_PORT=5433

N8N_PORT=5678
# Any long random string; changing it later makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
TZ=UTC
